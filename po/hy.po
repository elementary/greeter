#: compositor/WindowManager.vala:362
#, c-format
msgid "Changes will automatically revert after %i second."
msgid_plural "Changes will automatically revert after %i seconds."
msgstr[0] ""
"Փոփոխությունները ավտոմատ կերպով կվերադարձվեն նախկին վիճակին %i վայրկյանից։"
msgstr[1] ""
"Փոփոխությունները ավտոմատ կերպով կվերադարձվեն նախկին վիճակին %i վայրկյանից։"

#: compositor/WindowManager.vala:369
msgid "Keep new display settings?"
msgstr "Պահպանե՞լ էկրանի նոր կարգավորումները։"

#: compositor/WindowManager.vala:373
msgid "Keep Settings"
msgstr "Պահպանել կարգավորումները"

#: compositor/WindowManager.vala:374
msgid "Use Previous Settings"
msgstr "Օգտագործել նախորդ կարգավորումները"

#: src/MainWindow.vala:44
msgid "Log in as Guest"
msgstr "Մուտք գործել որպես հյուր"

#: src/MainWindow.vala:45
msgid "Manual Login…"
msgstr "Ձեռքով մուտք…"

#: src/MainWindow.vala:320
msgid "Unable to Log In"
msgstr "Չհաջողվեց մուտք գործել"

#: src/MainWindow.vala:321
msgid "Starting the session has failed."
msgstr "Աշխատաշրջանը սկսել չհաջողվեց։"

#: src/MainWindow.vala:383
msgid "Unable to Launch Initial Setup"
msgstr "Չհաջողվեց գործարկել սկզբնական կարգավորումը"

#: src/MainWindow.vala:388
msgid ""
"Initial Setup creates your first user. Without it, you will not be able to "
"log in and may need to reinstall the OS."
msgstr ""
"Սկզբնական կարգավորումը ստեղծում է Ձեր առաջին օգտատիրոջը։ Առանց դրա Դուք չեք "
"կարողանա մուտք գործել և հնարավոր է՝ հարկ լինի վերատեղադրել ՕՀ-ն։"

#: src/Cards/ManualCard.vala:21
msgid "Manual Login"
msgstr "Ձեռքով մուտք"

#: src/Cards/ManualCard.vala:30
msgid "Username"
msgstr "Օգտանուն"

#: src/Cards/UserCard.vala:63 src/Widgets/PasswordEntry.vala:27
msgid "Log In"
msgstr "Մուտք գործել"

#: src/Cards/UserCard.vala:81
msgid "Account disabled"
msgstr "Հաշիվն անջատված է"

#: src/Cards/UserCard.vala:137 src/Cards/UserCard.vala:140
msgid "Session cannot be changed while user is logged in"
msgstr "Աշխատաշրջանը հնարավոր չէ փոխել, քանի դեռ օգտատերը մուտք է գործել"

#: src/Widgets/CapsLockRevealer.vala:52
msgid "Caps Lock & Num Lock are on"
msgstr "Caps Lock-ը և Num Lock-ը միացված են"

#: src/Widgets/CapsLockRevealer.vala:54
msgid "Caps Lock is on"
msgstr "Caps Lock-ը միացված է"

#: src/Widgets/CapsLockRevealer.vala:56
msgid "Num Lock is on"
msgstr "Num Lock-ը միացված է"

#: src/Widgets/PasswordEntry.vala:24
msgid "Password"
msgstr "Գաղտնաբառ"

